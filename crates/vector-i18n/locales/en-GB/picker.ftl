### The emoji, GIF and kaomoji picker.

## Tabs, sections and search

picker-emoji = Emoji
picker-search-results = Search Results
picker-recently-used = Recently Used
picker-emojis = Emojis
picker-search-emojis = Search Emojis...
picker-search-gifs = Search GIFs...
picker-search-kaomoji = Search Kaomoji...
# Screen readers name the side rail's buttons by these.
picker-rail-recents = Recently used
picker-rail-all = All emojis
picker-create-pack = Create new pack
picker-edit-pack = Edit Pack

## Nothing to show

picker-gifs-no-trending = No trending GIFs found
# $query is what was searched for, cut short with "..." when long.
picker-gifs-none = No GIFs found for "{ $query }"
picker-gifs-failed = Failed to load GIFs
picker-gifs-search-failed = Search failed
# $query is what was searched for.
picker-kaomoji-none = No kaomoji for “{ $query }”

## A pack its creator took down, or that can't be found. Each pack shows one of three
## wordings, picked so it stays the same between opens.

picker-pack-revoked-1 = The creator has taken this pack down.
picker-pack-revoked-2 = This pack was removed by its creator.
picker-pack-revoked-3 = The creator of this pack has retired it.
picker-pack-missing-1 = This pack is no longer available.
picker-pack-missing-2 = This pack seems to have disappeared.
picker-pack-missing-3 = This pack couldn't be found anymore.
picker-pack-dead-note = Old messages will still show its emojis.
picker-pack-remove = Remove Pack
