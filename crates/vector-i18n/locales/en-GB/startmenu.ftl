### The Main Menu: its places, pinned tiles and folders, search, and the controls at its foot.

## Places in the left column, which search also finds

start-accounts = Accounts
start-profile = Profile
start-chat = Chat
start-bookmarks = Bookmarks
start-miniapps = Mini Apps
start-settings = Settings

## A search result's or pin's kind, under its name

start-kind-dm = Direct Message
# Under the left column's places: they belong to the app itself.
start-kind-app = Vector
start-kind-settings = Settings
# A section inside a Settings page. $page is the page's name.
start-kind-settings-page = Settings › { $page }
start-kind-messages = Messages
start-kind-miniapps = Mini Apps
start-kind-miniapp = Mini App
start-kind-community = Community
# Under a pasted npub that is the account's own.
start-kind-you = You
# Under a pasted npub of someone else.
start-kind-person = Person
# Under a pinned community this account isn't a member of.
start-kind-not-member = A community you're not in

## Names for pins

start-requests = Requests
start-app-store = App Store
# A pinned community or channel this device knows nothing about.
start-unknown-community = Community
start-unknown-channel = Channel
start-folder = Folder
start-pinned = Pinned
start-add-pin = Add Pin
start-add-account = Add Account
# The account's own tile before its profile has loaded.
start-you = You

## Search. Headings are shown in capitals.

start-results = Results
start-add-pins = Add Pins
# $query is what was typed; <b> sets it brighter.
start-no-results = No results for <b>“{ $query }”</b>
    .hint = Try a name, a community, a Mini App or a setting.
    .action = Search the App Store
# While choosing what to pin. $query is what was typed; <b> sets it brighter.
start-nothing-to-pin = Nothing to pin called <b>“{ $query }”</b>
    .hint = Pin a Mini App, a chat, a community or a place in Settings.
# Beside a person found by their npub: opens a chat with them.
start-message = Message

