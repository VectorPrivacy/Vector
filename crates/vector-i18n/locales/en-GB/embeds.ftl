### Link previews and embedded media in messages.

## Why a YouTube video won't play here

embed-youtube-owner-only = Its owner only allows it on YouTube
embed-youtube-removed = Removed or made private on YouTube
embed-youtube-refused = YouTube won't play it in other apps

## Copying a Nostr reference that didn't load

# $kind is the code, like "nevent" or "naddr".
embed-copy = Copy { $kind }
# $kind is the code, like "nevent" or "naddr".
embed-copied = The { $kind } copied
# A note's code is called its note ID.
embed-note-id = note ID

## What a Nostr reference is, as a chat-list snippet or a card's eyebrow

embed-nostr = Nostr
embed-nostr-post = Nostr Post
embed-nostr-comment = Nostr Comment
embed-nostr-article = Nostr Article
embed-nostr-video = Nostr Video
embed-nostr-short = Nostr Short
embed-nostr-repost = Nostr Repost
# $name reposted it. Sometimes shown in capitals.
embed-reposted-by = Reposted by { $name }

## A quoted Nostr reference's label

embed-quote = Quote
embed-quote-post = Quoted Post
embed-quote-comment = Quoted Comment
embed-quote-article = Quoted Article
embed-quote-video = Quoted Video
embed-quote-short = Quoted Short
embed-quote-repost = Quoted Repost

## A Nostr card

embed-failed = This post couldn't be loaded
embed-open-externally = Open Externally
embed-read-article = Read Article
embed-show-more = Show More
embed-content-warning = Content warning
# $reason is the warning the author gave.
embed-content-warning-reason = Content warning: { $reason }
# Reveals a post behind a content warning.
embed-show = Show
embed-video-failed = Couldn't download the video. Tap to try again.
# Followed by what the comment answers, like "a post", which opens it.
embed-replying-to = Replying to
embed-reply-post = a post
embed-reply-comment = a comment
embed-reply-article = an article
embed-reply-video = a video
embed-reply-short = a short
embed-reply-file = a file
embed-reply-live = a live stream
embed-reply-community = a community
embed-reply-event = a Nostr event

## Why a video in a post won't play

embed-video-not-web = Not a web video
embed-video-not-video = Not a video
embed-video-memory-show = Too much media is open to show this one
embed-video-memory-play = Too much media is open to play this one
embed-video-downloading = This video is already downloading
embed-video-too-large = This video is too large to play in chat
embed-video-download-failed = Failed to download
embed-video-server-error = Media server returned an error status
embed-video-ended-early = The download ended early
embed-video-fingerprint = The video doesn't match the post's fingerprint
embed-video-host-silent = The video host stopped answering
embed-video-host-stalled = The video host stalled
embed-video-stopped-loading = The video stopped loading
embed-video-no-ranges = The video host stopped answering ranges
# $status is the server's answer, like "404 Not Found".
embed-video-host-status = The video host answered { $status }
embed-video-short-range = The video host sent a short range

## A link preview card

embed-link-preview = Link Preview
# $service is where it plays from, like "YouTube".
embed-plays-from = Plays from { $service }
embed-opens-browser = Opens in your browser
