### The accounts on this device: the switcher, the login list and the Main Menu's account rows.

# An account that has no display name yet.
account-unnamed = Unnamed
account-add = Add Profile
# Shown instead of account-add once the device holds as many accounts as it can.
account-max = Maximum Accounts
account-logout-failed = Logout failed
account-delete-failed = Delete failed
account-switch-failed = Switch failed
account-delete-streamer = Turn off Streamer Mode to delete another account.
# Stands in for an account's name in account-remove-text.
account-this = This account
account-remove-title = Remove Profile?
# $name is the account's name.
account-remove-text = { $name } will be permanently removed from this device, with the files it keeps in Vector. Make sure you have the seed phrase or nsec backed up if you want to recover it later, and save any files you want to keep.
account-remove-last = This is your only Vector account on this device. All downloaded attachments will also be removed. Copy any files you want to keep before continuing.
account-syncing = Syncing your account — try again in a moment
account-sign-out-first = Sign out of this account first
