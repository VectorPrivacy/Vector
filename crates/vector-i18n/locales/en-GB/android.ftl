### Android's own surfaces: notifications, their channels in the system's settings, the share
### and open-with sheets, and the fingerprint prompt.

## A call's notification

android-call-incoming = Incoming call
android-call-incoming-video = Incoming video call
android-call-missed = Missed call
android-call-decline = Decline
android-call-answer = Answer
# Under the other person's name while a call runs.
android-call-voice = Call
android-call-video = Video call
android-call-muted = Muted
android-call-mute = Mute
android-call-unmute = Unmute
# While a call is starting and nobody is shown yet.
android-call-ongoing = In a call
android-call-return = Tap to return to Vector
android-call-leave = Leave

## A message's notification

# The sender of a Community message whose name is not known.
android-notify-someone = Someone
# You, in a conversation's notification.
android-notify-me = Me
android-notify-reply = Reply
android-notify-mark-read = Mark Read

## While Vector runs in the background. One of the three lines follows at random.

android-service-listening = Listening for messages
android-service-tagline-watch = Keeping watch
android-service-tagline-miss = You won't miss a thing
android-service-tagline-standby = Standing by

## Notification channels, as Android's settings list them

android-channel-ring = Incoming calls
android-channel-ring-about = Rings when someone calls you
android-channel-missed = Missed calls
android-channel-missed-about = Calls you didn't answer
android-channel-calls = Calls
android-channel-calls-about = Shown while you're in a call
android-channel-messages = Messages
android-channel-messages-about = New message notifications
android-channel-service = Background Service
android-channel-service-about = Keeps Vector connected for real-time messages

## Sheets and prompts

# Titles the list of apps that can open a file.
android-open-with = Open with
android-share = Share
# Names the way to unlock, when the phone doesn't say: fingerprint or face, or else the
# phone's own PIN, pattern or password.
android-biometric-use = Use biometrics
android-biometric-screen-lock = Use screen lock
android-biometric-enable = Enable Biometric Unlock
android-biometric-unlock = Unlock Vector
