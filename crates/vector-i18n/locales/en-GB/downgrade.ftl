### The screen shown when this account's data was last used by a newer Vector.

# A pre-release version. $version is like "0.6.0"; $number counts the previews.
version-preview = v{ $version } Preview { $number }
# When the newer version isn't known.
downgrade-newer = A newer version
downgrade-title = Vector can't open this account
downgrade-text = Your data was last used with a newer version of Vector. Opening it with this older build would damage your message history.
downgrade-this-build = This build
downgrade-data-needs = Your data needs
downgrade-safe = Nothing has been lost. Your messages are intact and will open again on the newer version.
downgrade-get-latest = Get the latest version
downgrade-quit = Quit Vector
