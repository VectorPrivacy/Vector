### A link to a place in Vector, shown as a pill in a message, and its tooltip.

golink-broken = Broken link
golink-broken-tip = This link is broken or incomplete
golink-unknown-community = Unknown community
golink-unknown-community-tip = A community you're not in
golink-unknown-channel = Unknown channel
golink-unknown-channel-tip = A channel that isn't available to you
# Stands in for a channel with no name.
golink-channel = channel
# $name is the community's name.
golink-private-channel-tip = Private channel in { $name }
# On the pill, after the channel's name, for a message that was deleted.
golink-deleted = deleted
golink-deleted-message = Deleted message
golink-not-here-yet = Not on this device yet
golink-message = Message
# $room is the channel, like "#general"; $name is the community's name.
golink-message-in-tip = Message in { $room }, { $name }
# $room is the channel, like "#general"; $name is the community's name.
golink-room-in-tip = { $room } in { $name }
# $name is who the conversation is with.
golink-message-with-tip = Message with { $name }
