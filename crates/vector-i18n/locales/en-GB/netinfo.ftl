## The card that introduces Tor or I2P: on the login screen, and from Settings. Text inside
## <b> shows bold and white. Tor and I2P are names.

netinfo-i2p-title = I2P Network
netinfo-i2p-lead = Route Vector through your own I2P router so relays and servers never see your IP address.
netinfo-i2p-point-ip = <b>IP Obfuscation</b>: relays see I2P, not you
netinfo-i2p-point-exit = <b>No Exit Needed</b>: .i2p relays never leave the network
netinfo-i2p-point-directory = <b>No Central Directory</b>: nothing central to block or seize
netinfo-i2p-point-tunnels = <b>One-Way Tunnels</b>: sending and receiving take separate paths
netinfo-i2p-note = <b>Expect slower connections.</b> Starting can take a few minutes. Servers outside I2P are reached through an outproxy, which can see and link the ones you use.
netinfo-i2p-disclaimer = I2P is independent software run by its volunteers, not operated by Vector.
netinfo-i2p-learn = Learn more about I2P
netinfo-tor-title = Tor Network
netinfo-tor-lead = Route Vector’s connection through Tor so relays and servers never see your real IP address.
netinfo-tor-point-ip = <b>IP Obfuscation</b>: relays see Tor, not you
netinfo-tor-point-location = <b>Location Privacy</b>: your country stays hidden
netinfo-tor-point-isp = <b>ISP Shielding</b>: your provider can’t see which relays you use
netinfo-tor-point-censorship = <b>Censorship Resistance</b>: reach relays blocked on your network
netinfo-tor-note = <b>Expect slower connections.</b> Your traffic takes a longer path through volunteer relays worldwide so messages and media take more time to send and load, noticeably slower than a VPN.
netinfo-tor-disclaimer = Tor is independent software maintained by the Tor Project, not operated by Vector.
netinfo-tor-learn = Learn more about Tor
netinfo-settings-hint = You can change this any time in Settings > Privacy > Routing.
