### Starting a chat: the New Message picker, and the card for a pasted invite or Vector link.

newchat-title = New Message
newchat-start = Start Chat
# An npub is a Nostr public key, the text people share to be found. Keep the word.
newchat-empty = No contacts yet. Paste an npub to invite someone.
newchat-no-matches = No matches.
# Under newchat-empty. <hub> is a link that opens the Vector Hub.
newchat-hub = <hub>Explore the Vector Hub</hub> to discover communities to join and meet new people.

## A pasted link's card. The small line over the name is shown in capitals.

newchat-invite = Community Invite
newchat-invite-loading = Loading invite...
newchat-invite-failed = Invite Unavailable
    .desc = This invite couldn't be loaded. It may have been revoked or expired, or its relays are unreachable.
# Over the name of the community the invite is for.
newchat-invited = You've been invited to join
newchat-your-community = Your Community
newchat-member = You're already a member
# A link to a place inside the app, such as a chat or a setting.
newchat-link = Vector Link
newchat-link-open = Open in Vector
    .desc = This link opens a place inside Vector.

## The card's buttons

newchat-open-link = Open Link
newchat-joining = Joining…
newchat-open-community = Open Community
newchat-join-community = Join Community
