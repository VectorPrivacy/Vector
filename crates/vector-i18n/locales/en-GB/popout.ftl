### The floating media player that keeps playing after you leave the chat.

# $community is the community's name; $channel is the channel's.
popout-place = { $community } › { $channel }
# Which song of an album is playing. $number counts from 1; $total is how many songs.
popout-track = { $number } of { $total }
popout-voice-message = Voice Message
popout-video = Video
popout-audio = Audio
popout-transcript-hide = Hide transcript
popout-transcript-show = Show transcript
popout-transcribe = Transcribe
popout-songs = Songs
popout-songs-hide = Hide songs
popout-show-video = Show video
popout-sound-only = Sound only
popout-show-in-chat = Show in chat
popout-close = Close
