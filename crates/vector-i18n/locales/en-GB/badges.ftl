### Badge cards: what earned a badge, and what it grants.

badge-inviter = Vector Beta Inviter
# <b> is bold. $count is how many people they invited.
badge-inviter-text = Acquired by inviting <b>{ $count ->
    [one] { $count } user
   *[other] { $count } users
}</b> to the Vector Beta!
badge-fawkes = V for Vector Badge
# Guy Fawkes Day is a British date; keep it and the date as they are.
badge-fawkes-text = Acquired by logging in on Guy Fawkes Day (November 5, 2025).
# A line from the old rhyme, shown faint under the badge's text.
badge-fawkes-aside = Remember, remember the 5th of November...
badge-bug-hunter = Bug Hunter
# $tier is from 1 to 3.
badge-tier = Tier { $tier }
badge-bug-hunter-text = Bug Hunter badges are one of the most prestigious awards to true contributors of Vector who have identified and reported bugs or issues.
badge-v2026-edition = 2026 Edition
badge-v2026-text = Remember, Remember... the Fifth of November.
# A quote from the film V for Vendetta.
badge-v2026-quote = “People should not be afraid of their governments. Governments should be afraid of their people.”

## What a badge grants

badge-full-access = Full Premium Access
badge-partial-access = Partial Premium Access
badge-no-invite-code = No invite code found for this user
