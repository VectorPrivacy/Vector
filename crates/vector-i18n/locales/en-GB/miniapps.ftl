### Mini Apps: the library, an app's details, and running one.

## Opening an app

miniapp-not-found = Not found
miniapp-gone = This app isn't on this device any more
miniapp-load-timeout = The Mini App took too long to load
miniapp-read-timeout = The Mini App took too long to read
miniapp-no-isolation = Network isolation unavailable for Mini Apps
miniapp-not-ready = The app isn't ready yet
miniapp-no-cache = No cache folder
# $error is why.
miniapp-prepare-failed = Couldn't prepare the app: { $error }
miniapp-no-path = Empty file path
# $path is where Vector looked.
miniapp-file-missing = File not found: { $path }
miniapp-unknown-file = Unknown file
# The title of the window a Mini App plays media in, when the app gives none.
miniapp-player = Player
