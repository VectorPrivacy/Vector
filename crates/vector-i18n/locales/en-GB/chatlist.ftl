### The list of chats, and a chat row's right-click menu.

chats-archived = Archived Chats

## A chat row's menu

chats-mark-read = Mark as Read
chats-mark-unread = Mark as Unread
# Pins the chat to the top of the list.
chats-pin = Pin
chats-unpin = Unpin
chats-archive = Archive
chats-unarchive = Unarchive
chats-block = Block
chats-mark-all-read = Mark All as Read

## Toasts

chats-unarchived = Chat Unarchived
chats-archived-toast = Chat Archived
# The first time a chat is archived, saying where archived chats went.
chats-archived-hint = Chat Archived. Pull or scroll past the top of your chats to find it.

## A chat's preview line: its last message

chats-preview-file = Sent a file
chats-preview-sending = Sending...
chats-preview-pivx = Sent a PIVX Payment
# $kind is a file type's name, like "Picture" or "PDF Document".
chats-preview-sent = Sent a { $kind }
# Stands in for a community invite link.
chats-preview-invite = Community Invite
# The last message was yours. $body is the preview, which may hold emoji and mentions.
chats-preview-mine = You: { $body }

## How long ago a chat was active, in its row: short forms

ago-now = Now
# $count is how many minutes.
ago-minutes = { $count }m
# $count is how many hours.
ago-hours = { $count }h
# $count is how many days.
ago-days = { $count }d
# $count is how many weeks.
ago-weeks = { $count }w
# $count is how many months.
ago-months = { $count }mo
# $count is how many years.
ago-years = { $count }y

