### Uploading files: progress, and why an upload was refused.

upload-cancelled = Upload Cancelled
# Opens the network routing settings from an upload error.
upload-open-routing = Open Routing
upload-compression-failed = Compression Failed
upload-no-server-title = No media server will take this file
# <b> is bold, <br> a line break. $size is the file's size, like "2.1 GB"; $reasons is each
# server's reason, already set out one per line.
upload-no-server-text = This file is <b>{ $size }</b>.{ $reasons }<br><br>Shrink the file, or add a server in Settings → Network.
