+// Rows of 0 for the first n_valid keys and -inf for the padding after them.
+static void whisper_set_pad_mask(struct ggml_tensor * mask, int n_valid, std::vector<ggml_fp16_t> & buf) {
+    const int64_t n_kv = mask->ne[0];
+    buf.resize(ggml_nelements(mask));
+    const ggml_fp16_t zero = ggml_fp32_to_fp16(0.0f);
+    const ggml_fp16_t ninf = ggml_fp32_to_fp16(-INFINITY);
+    for (int64_t j = 0; j < n_kv; ++j) {
+        buf[j] = j < n_valid ? zero : ninf;
+    }
+    for (int64_t r = 1; r < mask->ne[1]; ++r) {
+        memcpy(buf.data() + r*n_kv, buf.data(), n_kv*sizeof(ggml_fp16_t));
+    }
+    ggml_backend_tensor_set(mask, buf.data(), 0, ggml_nbytes(mask));
+}
