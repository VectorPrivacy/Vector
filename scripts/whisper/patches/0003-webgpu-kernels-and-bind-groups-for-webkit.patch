+++ b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_vec_lanes.wgsl
@@ -0,0 +1,104 @@
+enable f16;
+
+// Mat-vec (one src1 column) for a Q8_0 or F16 src0 and an F32 src1: 64 threads cover eight
+// rows, eight lanes per row striding along k with vec4 loads, then a fixed eight-way sum.
+
+struct MulMatParams {
+    offset_src0: u32,
+    offset_src1: u32,
+    offset_dst: u32,
+    m: u32,
+    n: u32,
+    k: u32,
+    stride_01: u32,
+    stride_11: u32,
+    stride_02: u32,
+    stride_12: u32,
+    stride_03: u32,
+    stride_13: u32,
+    bs02: u32,
+    bs03: u32,
+    broadcast2: u32,
+    broadcast3: u32
+};
+
+@group(0) @binding(0) var<storage, read_write> src0: array<u32>;
+@group(0) @binding(1) var<storage, read_write> src1: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read_write> dst: array<f32>;
+@group(0) @binding(3) var<uniform> params: MulMatParams;
+
+var<workgroup> partial: array<f32, 64>;
+
+#ifdef SRC0_Q8_0
+fn q8_word(w: u32) -> vec4<f32> {
+    return vec4<f32>(vec4<i32>(i32(w << 24u) >> 24u, i32(w << 16u) >> 24u, i32(w << 8u) >> 24u, i32(w) >> 24u));
+}
+
+fn row_dot(row_base: u32, x_base: u32, lane: u32) -> f32 {
+    var acc = 0.0;
+    let nb = params.k / 32u;
+    for (var b = lane; b < nb; b += 8u) {
+        let blk = (row_base + b) * 34u;
+        let d = unpack2x16float(src0[blk / 4u] >> ((blk % 4u) * 8u)).x;
+        let qb = blk + 2u;
+        let qs = (qb % 4u) * 8u;
+        let qw = qb / 4u;
+        let xb = x_base + b * 8u;
+        var s = 0.0;
+        var prev = src0[qw];
+        for (var j = 0u; j < 8u; j++) {
+            let next = src0[qw + j + 1u];
+            let w = select((prev >> qs) | (next << (32u - qs)), prev, qs == 0u);
+            s += dot(q8_word(w), src1[xb + j]);
+            prev = next;
+        }
+        acc += s * d;
+    }
+    return acc;
+}
+#endif
+
+#ifdef SRC0_F16
+fn row_dot(row_base: u32, x_base: u32, lane: u32) -> f32 {
+    var acc = 0.0;
+    let nc = params.k / 4u;
+    for (var c = lane; c < nc; c += 8u) {
+        let w = row_base / 2u + c * 2u;
+        acc += dot(vec4<f32>(unpack2x16float(src0[w]), unpack2x16float(src0[w + 1u])), src1[x_base + c]);
+    }
+    return acc;
+}
+#endif
+
+@compute @workgroup_size(64)
+fn main(@builtin(workgroup_id) wg_id: vec3<u32>,
+        @builtin(local_invocation_index) t: u32,
+        @builtin(num_workgroups) num_wg: vec3<u32>) {
+    let row_groups = (params.m + 7u) / 8u;
+    let wg_linear = wg_id.y * num_wg.x + wg_id.x;
+    let batch_idx = wg_linear / row_groups;
+    if (batch_idx >= params.bs02 * params.broadcast2 * params.bs03 * params.broadcast3) {
+        return;
+    }
+    let dst3_idx = batch_idx / (params.bs02 * params.broadcast2);
+    let dst2_idx = batch_idx % (params.bs02 * params.broadcast2);
+    let base0 = params.offset_src0 + (dst3_idx / params.broadcast3) * params.stride_03 + (dst2_idx / params.broadcast2) * params.stride_02;
+    let base1 = params.offset_src1 + dst3_idx * params.stride_13 + dst2_idx * params.stride_12;
+
+    let row = (wg_linear % row_groups) * 8u + t / 8u;
+    let lane = t % 8u;
+
+    var acc = 0.0;
+    if (row < params.m) {
+        acc = row_dot(base0 + row * params.stride_01, base1 / 4u, lane);
+    }
+    partial[t] = acc;
+    workgroupBarrier();
+
+    if (lane == 0u && row < params.m) {
+        let p = t;
+        let total = (partial[p] + partial[p + 1u]) + (partial[p + 2u] + partial[p + 3u]) +
+                    (partial[p + 4u] + partial[p + 5u]) + (partial[p + 6u] + partial[p + 7u]);
+        dst[params.offset_dst + dst3_idx * (params.m * params.bs02 * params.broadcast2) + dst2_idx * params.m + row] = total;
+    }
+}
