diff --git a/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_tile8.wgsl b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_tile8.wgsl
new file mode 100644
index 0000000..c5666c7
--- /dev/null
+++ b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_tile8.wgsl
@@ -0,0 +1,169 @@
+enable f16;
+
+// Mat-mat for a Q8_0 or F16 src0 and an F32 src1, written for compilers that keep private
+// arrays in memory: shared tiles are k-major so every inner-loop load is a vec4, and each
+// thread's 8x8 output block lives in sixteen vec4 variables. 64 threads, 64x64 per workgroup.
+
+struct MulMatParams {
+    offset_src0: u32,
+    offset_src1: u32,
+    offset_dst: u32,
+    m: u32,
+    n: u32,
+    k: u32,
+    stride_01: u32,
+    stride_11: u32,
+    stride_02: u32,
+    stride_12: u32,
+    stride_03: u32,
+    stride_13: u32,
+    bs02: u32,
+    bs03: u32,
+    broadcast2: u32,
+    broadcast3: u32
+};
+
+@group(0) @binding(0) var<storage, read_write> src0: array<u32>;
+@group(0) @binding(1) var<storage, read_write> src1: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read_write> dst: array<f32>;
+@group(0) @binding(3) var<uniform> params: MulMatParams;
+
+const TILE_K = 32u;
+
+var<workgroup> shmem_a: array<vec4<f16>, TILE_K * 16u>; // [k][m / 4]
+var<workgroup> shmem_b: array<vec4<f16>, TILE_K * 16u>; // [k][n / 4]
+
+#ifdef SRC0_Q8_0
+fn q8_word(w: u32) -> vec4<f32> {
+    return vec4<f32>(vec4<i32>(i32(w << 24u) >> 24u, i32(w << 16u) >> 24u, i32(w << 8u) >> 24u, i32(w) >> 24u));
+}
+
+// Eight weights of row `gm` from k = k8 (a multiple of 8), as two vec4s.
+fn load_a8(base: u32, gm: u32, k8: u32, lo: ptr<function, vec4<f32>>, hi: ptr<function, vec4<f32>>) {
+    let blk = (base + gm * params.stride_01 + k8 / 32u) * 34u; // byte offset of the block
+    let d = unpack2x16float(src0[blk / 4u] >> ((blk % 4u) * 8u)).x;
+    let qb = blk + 2u + k8 % 32u;
+    let qs = (qb % 4u) * 8u;
+    let qw = qb / 4u;
+    let x0 = src0[qw];
+    let x1 = src0[qw + 1u];
+    let x2 = src0[qw + 2u];
+    let w0 = select((x0 >> qs) | (x1 << (32u - qs)), x0, qs == 0u);
+    let w1 = select((x1 >> qs) | (x2 << (32u - qs)), x1, qs == 0u);
+    *lo = q8_word(w0) * d;
+    *hi = q8_word(w1) * d;
+}
+#endif
+
+#ifdef SRC0_F16
+fn load_a8(base: u32, gm: u32, k8: u32, lo: ptr<function, vec4<f32>>, hi: ptr<function, vec4<f32>>) {
+    let w = (base + gm * params.stride_01 + k8) / 2u;
+    *lo = vec4<f32>(unpack2x16float(src0[w]), unpack2x16float(src0[w + 1u]));
+    if (k8 + 4u < params.k) {
+        *hi = vec4<f32>(unpack2x16float(src0[w + 2u]), unpack2x16float(src0[w + 3u]));
+    }
+}
+#endif
+
+@compute @workgroup_size(64)
+fn main(@builtin(workgroup_id) wg_id: vec3<u32>,
+        @builtin(local_invocation_index) t: u32,
+        @builtin(num_workgroups) num_wg: vec3<u32>) {
+    let wg_m_count = (params.m + 63u) / 64u;
+    let wg_n_count = (params.n + 63u) / 64u;
+    let wg_per_matrix = wg_m_count * wg_n_count;
+    let wg_linear = wg_id.y * num_wg.x + wg_id.x;
+    let batch_idx = wg_linear / wg_per_matrix;
+    if (batch_idx >= params.bs02 * params.broadcast2 * params.bs03 * params.broadcast3) {
+        return;
+    }
+    let wg_in_batch = wg_linear % wg_per_matrix;
+    let m0 = (wg_in_batch % wg_m_count) * 64u;
+    let n0 = (wg_in_batch / wg_m_count) * 64u;
+
+    let dst3_idx = batch_idx / (params.bs02 * params.broadcast2);
+    let dst2_idx = batch_idx % (params.bs02 * params.broadcast2);
+    let base0 = params.offset_src0 + (dst3_idx / params.broadcast3) * params.stride_03 + (dst2_idx / params.broadcast2) * params.stride_02;
+    let base1 = params.offset_src1 + dst3_idx * params.stride_13 + dst2_idx * params.stride_12;
+
+    // loader roles: four rows (m or n) per thread, a slice of k
+    let rg = t % 16u;
+    let kc = t / 16u;
+    // compute roles: an 8x8 block of the 64x64 tile
+    let lm = t % 8u;
+    let ln = t / 8u;
+
+    var c00 = vec4<f32>(); var c01 = vec4<f32>(); var c02 = vec4<f32>(); var c03 = vec4<f32>();
+    var c04 = vec4<f32>(); var c05 = vec4<f32>(); var c06 = vec4<f32>(); var c07 = vec4<f32>();
+    var c10 = vec4<f32>(); var c11 = vec4<f32>(); var c12 = vec4<f32>(); var c13 = vec4<f32>();
+    var c14 = vec4<f32>(); var c15 = vec4<f32>(); var c16 = vec4<f32>(); var c17 = vec4<f32>();
+
+    for (var k0 = 0u; k0 < params.k; k0 += TILE_K) {
+        {
+            let k8 = k0 + kc * 8u;
+            var lo: array<vec4<f32>, 4>;
+            var hi: array<vec4<f32>, 4>;
+            for (var r = 0u; r < 4u; r++) {
+                let gm = m0 + rg * 4u + r;
+                var l = vec4<f32>();
+                var h = vec4<f32>();
+                if (gm < params.m && k8 < params.k) {
+                    load_a8(base0, gm, k8, &l, &h);
+                }
+                lo[r] = l;
+                hi[r] = h;
+            }
+            for (var j = 0u; j < 4u; j++) {
+                shmem_a[(kc * 8u + j) * 16u + rg] = vec4<f16>(vec4<f32>(lo[0][j], lo[1][j], lo[2][j], lo[3][j]));
+                shmem_a[(kc * 8u + 4u + j) * 16u + rg] = vec4<f16>(vec4<f32>(hi[0][j], hi[1][j], hi[2][j], hi[3][j]));
+            }
+        }
+        for (var kq = kc * 2u; kq < kc * 2u + 2u; kq++) {
+            let gk = k0 + kq * 4u;
+            var v: array<vec4<f32>, 4>;
+            for (var r = 0u; r < 4u; r++) {
+                let gn = n0 + rg * 4u + r;
+                var x = vec4<f32>();
+                if (gn < params.n && gk < params.k) {
+                    x = src1[(base1 + gn * params.stride_11 + gk) / 4u];
+                }
+                v[r] = x;
+            }
+            for (var j = 0u; j < 4u; j++) {
+                shmem_b[(kq * 4u + j) * 16u + rg] = vec4<f16>(vec4<f32>(v[0][j], v[1][j], v[2][j], v[3][j]));
+            }
+        }
+        workgroupBarrier();
+
+        for (var kk = 0u; kk < TILE_K; kk++) {
+            let a0 = vec4<f32>(shmem_a[kk * 16u + lm * 2u]);
+            let a1 = vec4<f32>(shmem_a[kk * 16u + lm * 2u + 1u]);
+            let b0 = vec4<f32>(shmem_b[kk * 16u + ln * 2u]);
+            let b1 = vec4<f32>(shmem_b[kk * 16u + ln * 2u + 1u]);
+            c00 += a0 * b0.x; c01 += a0 * b0.y; c02 += a0 * b0.z; c03 += a0 * b0.w;
+            c04 += a0 * b1.x; c05 += a0 * b1.y; c06 += a0 * b1.z; c07 += a0 * b1.w;
+            c10 += a1 * b0.x; c11 += a1 * b0.y; c12 += a1 * b0.z; c13 += a1 * b0.w;
+            c14 += a1 * b1.x; c15 += a1 * b1.y; c16 += a1 * b1.z; c17 += a1 * b1.w;
+        }
+        workgroupBarrier();
+    }
+
+    let dst_base = params.offset_dst + dst3_idx * (params.m * params.n * params.bs02 * params.broadcast2) + dst2_idx * (params.m * params.n);
+    let gm = m0 + lm * 8u;
+    let gn = n0 + ln * 8u;
+    let blocks = array<vec4<f32>, 16>(c00, c01, c02, c03, c04, c05, c06, c07, c10, c11, c12, c13, c14, c15, c16, c17);
+    for (var j = 0u; j < 8u; j++) {
+        let n = gn + j;
+        if (n < params.n) {
+            for (var h = 0u; h < 2u; h++) {
+                let v = blocks[h * 8u + j];
+                for (var r = 0u; r < 4u; r++) {
+                    let m = gm + h * 4u + r;
+                    if (m < params.m) {
+                        dst[dst_base + n * params.m + m] = v[r];
+                    }
+                }
+            }
+        }
+    }
+}
