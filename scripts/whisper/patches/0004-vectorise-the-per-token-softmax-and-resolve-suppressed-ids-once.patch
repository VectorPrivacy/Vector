+// The vocabulary-wide passes run once per decoded token and per decoder, so they are vectorised:
+// e^x for x <= 0 (all softmax needs) by the reduction and polynomial of ggml_v_expf, within 2 ulp.
+#if defined(__GNUC__) || defined(__clang__)
+#define WHISPER_VEC_LOGITS 1
+typedef float    whisper_v4f __attribute__((vector_size(16), aligned(4)));
+typedef int32_t  whisper_v4i __attribute__((vector_size(16), aligned(4)));
+typedef uint32_t whisper_v4u __attribute__((vector_size(16), aligned(4)));
+
+static inline whisper_v4f whisper_v4f_set(float x) {
+    return whisper_v4f{ x, x, x, x };
+}
+
+static inline whisper_v4f whisper_v4f_select(whisper_v4i m, whisper_v4f a, whisper_v4f b) {
+    return (whisper_v4f) ((m & (whisper_v4i) a) | (~m & (whisper_v4i) b));
+}
+
+static inline whisper_v4f whisper_v4f_exp_neg(whisper_v4f x) {
+    // written so that NaN lands here too, weighing nothing, as the scalar loops skip it
+    const whisper_v4i ninf = ~(x >= whisper_v4f_set(-87.0f));
+    x = whisper_v4f_select(ninf, whisper_v4f_set(-87.0f), x);
+    const whisper_v4f r = whisper_v4f_set(0x1.8p23f);
+    const whisper_v4f z = x*whisper_v4f_set(0x1.715476p+0f) + r;
+    const whisper_v4f n = z - r;
+    const whisper_v4f b = x - n*whisper_v4f_set(0x1.62e4p-1f) - n*whisper_v4f_set(0x1.7f7d1cp-20f);
+    const whisper_v4f k = (whisper_v4f) (((whisper_v4u) z << 23) + (whisper_v4u) whisper_v4f_set(1.0f));
+    const whisper_v4f u = b*b;
+    const whisper_v4f j = whisper_v4f_set(0x1.ffffecp-1f)*b +
+        (whisper_v4f_set(0x1.fffdb6p-2f) + whisper_v4f_set(0x1.555e66p-3f)*b +
+         (whisper_v4f_set(0x1.573e2ep-5f) + whisper_v4f_set(0x1.0e4020p-7f)*b)*u)*u;
+    // e^-87 is 1.6e-38, nothing beside the e^0 = 1 every sum here holds; a masked (-inf) logit is 0
+    return whisper_v4f_select(ninf, whisper_v4f_set(0.0f), k + k*j);
+}
+
+static inline whisper_v4f whisper_v4f_load(const float * p) {
+    whisper_v4f v;
+    memcpy(&v, p, sizeof(v));
+    return v;
+}
+
+static inline void whisper_v4f_store(float * p, whisper_v4f v) {
+    memcpy(p, &v, sizeof(v));
+}
+#endif
+
+static float whisper_max(const float * x, int n) {
+    float m = -INFINITY;
+    int i = 0;
+#ifdef WHISPER_VEC_LOGITS
+    if (n >= 4) {
+        whisper_v4f vm = whisper_v4f_set(-INFINITY);
+        for (; i + 4 <= n; i += 4) {
+            const whisper_v4f v = whisper_v4f_load(x + i);
+            vm = whisper_v4f_select(v > vm, v, vm);
+        }
+        m = std::max(std::max(vm[0], vm[1]), std::max(vm[2], vm[3]));
+    }
+#endif
+    for (; i < n; ++i) {
+        m = std::max(m, x[i]);
+    }
+    return m;
+}
+
+// y[i] = e^(x[i] - m) for x[i] <= m, returning their sum: blocks summed in float, the blocks in
+// double, since one running float total drops the vocabulary's long tail of tiny terms
+static float whisper_exp_sum(const float * x, float m, float * y, int n) {
+    double sum = 0.0;
+    int i = 0;
+#ifdef WHISPER_VEC_LOGITS
+    const whisper_v4f vm = whisper_v4f_set(m);
+    while (i + 4 <= n) {
+        whisper_v4f vs = whisper_v4f_set(0.0f);
+        for (const int end = std::min(n, i + 256); i + 4 <= end; i += 4) {
+            const whisper_v4f e = whisper_v4f_exp_neg(whisper_v4f_load(x + i) - vm);
+            if (y) {
+                whisper_v4f_store(y + i, e);
+            }
+            vs += e;
+        }
+        sum += (vs[0] + vs[1]) + (vs[2] + vs[3]);
+    }
+#endif
+    for (; i < n; ++i) {
+        const float e = x[i] > -INFINITY ? expf(x[i] - m) : 0.0f;
+        if (y) {
+            y[i] = e;
+        }
+        sum += e;
+    }
+    return (float) sum;
+}
+
+// the first index of the largest element
+static int whisper_argmax(const float * x, int n) {
+    int best = 0;
+    float vbest = n > 0 ? x[0] : 0.0f;
+    int i = 0;
+#ifdef WHISPER_VEC_LOGITS
+    if (n >= 4) {
+        whisper_v4f vm = whisper_v4f_load(x);
+        whisper_v4i vi = whisper_v4i{ 0, 1, 2, 3 };
+        whisper_v4i cur = vi;
+        for (i = 4; i + 4 <= n; i += 4) {
+            cur += 4;
+            const whisper_v4f v = whisper_v4f_load(x + i);
+            const whisper_v4i gt = v > vm;
+            vm = whisper_v4f_select(gt, v, vm);
+            vi = (gt & cur) | (~gt & vi);
+        }
+        best = vi[0]; vbest = vm[0];
+        for (int l = 1; l < 4; ++l) {
+            if (vm[l] > vbest || (vm[l] == vbest && vi[l] < best)) {
+                best = vi[l]; vbest = vm[l];
+            }
+        }
+    }
+#endif
+    for (; i < n; ++i) {
+        if (x[i] > vbest) {
+            best = i; vbest = x[i];
+        }
+    }
+    return best;
+}
 
