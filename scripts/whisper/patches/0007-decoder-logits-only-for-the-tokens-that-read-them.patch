+// The tokens of a batch whose logits are read; reserving, up to one per decoder.
+static int whisper_batch_n_outputs(const whisper_batch & batch, bool worst_case) {
+    if (worst_case) {
+        return std::min(batch.n_tokens, WHISPER_MAX_DECODERS);
+    }
+    int n = 0;
+    for (int i = 0; i < batch.n_tokens; ++i) {
+        n += batch.logits[i] != 0;
+    }
+    return n > 0 ? n : batch.n_tokens;
+}
