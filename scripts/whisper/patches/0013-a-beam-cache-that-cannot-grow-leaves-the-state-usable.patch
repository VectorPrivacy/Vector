+                        if (!whisper_kv_cache_init(state->kv_self, state->backends[0], ctx->itype,
+                                    ctx->model.hparams.n_text_state,
+                                    ctx->model.hparams.n_text_layer,
+                                    cache_size(state->kv_self_n_dec))) {
+                            WHISPER_LOG_ERROR("%s: nor could the previous self-attention cache be restored\n", __func__);
+                            state->kv_self_n_dec = 0; // the next call allocates one afresh
+                        }
                         return -7;
                     }
 
