{
  "name": "Vector",
  "short_name": "Vector",
  "description": "Private, end-to-end encrypted messaging.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "orientation": "portrait",
  "background_color": "#030303",
