<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP to loopback only: the media server (Range requests for <video>/<audio>)
     on 127.0.0.1, and the embedded players' host page, which must be named localhost.
     All other hosts remain HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
