  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:dev:bare": "tauri dev -- --no-default-features",
    "tauri:build:bare": "tauri build -- --no-default-features",
    "dev": "npm run tauri:dev",
    "build": "npm run tauri:build",
    "dev:bare": "npm run tauri:dev:bare",
    "build:bare": "npm run tauri:build:bare",
    "android:dev": "./scripts/android-dev.sh",
    "android:build": "tauri android build --target aarch64 armv7",
    "svelte:build": "node scripts/build-svelte.mjs",
    "svelte:watch": "node scripts/build-svelte.mjs --watch",
    "test:cache": "node --test \"tests/event-cache/*.test.mjs\"",
    "android:emu": "./scripts/android-emu.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.6",
    "emojibase-data": "^17.0.0",
    "esbuild": "^0.28.1",
    "esbuild-svelte": "^0.9.5",
